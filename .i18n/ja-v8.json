 {
  "id": "b5fc911259",
  "ja": "スズキ・ジムニーシエラ II、ルーフトップテント、2名。受け取りは沖縄市池原のEvertrail営業所、\n          返却は那覇空港。"
 },
 {
  "id": "dedec90ef0",
  "ja": "瀬底島発のボートファンダイビング。水納島または瀬底島で2ダイブ。少人数制、自社ボート、\n          水中写真付き。"
 },
 {
  "id": "cd7f00b67d",
  "ja": "泳げる海、夜間は\n          <span class=\"u\" data-metric=\"24 &deg;C\" data-imperial=\"76 &deg;F\">24 &deg;C</span>前後。にわか雨は短時間、吹きさらしのサイトでの主なリスクは風。10月は台風シーズン &mdash; 3日間で300 km以内を通る確率は約10分の1。"
 },
 {
  "id": "9e131a03be",
  "ja": "伊江島を望む丘の上の赤瓦の家。ピザ、マンゴー。"
 },
 {
  "id": "2b50ad8fad",
  "ja": "フクギ並木の砂地のテラス、伊江島を望む。"
 },
 {
  "id": "e39afe60c5",
  "ja": "ハンモック席のある高台のテラス。ぶくぶく茶。"
 },
 {
  "id": "7adb53f9a7",
  "ja": "読谷村の海岸線に建つ。岩場に屋外160席。"
 },
 {
  "id": "50a43713ce",
  "ja": "穏やかな湾、市街に沈む夕日。トイレなし。"
 },
 {
  "id": "411ce1bf6f",
  "ja": "森林サイト。広い区画、炊事場、トイレ、シャワー。"
 },
 {
  "id": "7d3e8a7736",
  "ja": "静かな湾、穏やかな海。トイレなし。公開座標は高速道路上。"
 },
 {
  "id": "aa92edceb6",
  "ja": "名護市街の道路橋の下、川沿いの空き地。水道とトイレ。ビーチなし。"
 },
 {
  "id": "45b20e29f5",
  "ja": "ビーチ直結の管理されたパーク。オートキャンプ、カヤックとSUPのレンタル。"
 },
 {
  "id": "a39fc4dbbd",
  "ja": "刈り込まれた芝、久高島からの朝日。トイレ、シャワー、東屋6棟。"
 },
 {
  "id": "4b4a47fd5e",
  "ja": "無料、砂浜の上。トイレあり。週末は混雑。"
 },
 {
  "id": "6c435ce85b",
  "ja": "無料、朝日側。星空。知念岬が近い。"
 },
 {
  "id": "a0b442bdfb",
  "ja": "名護近くの管理キャンプ場。シャワー、トイレ、Wi-Fi。下段の区画は風をしのげる。"
 },
 {
  "id": "a934d5cca8",
  "ja": "オートキャンプとバンガロー。バーベキュー設備、ボートとカヤックのレンタル。"
 },
 {
  "id": "f8b06d1ddf",
  "ja": "古宇利大橋の眺め、海に沈む夕日。駐車は1台分。"
 },
 {
  "id": "15db5857ea",
  "ja": "人の少ない海岸、海に沈む夕日。行き止まりの道、駐車スペースは極小。"
 },
 {
  "id": "b59e25de1f",
  "ja": "日陰あり、夕日側、古宇利大橋の正面。潮位線から離れて駐車。"
 },
 {
  "id": "6fb4578b08",
  "ja": "夕日のビーチ。道の駅とコンビニが隣接。"
 },
 {
  "id": "902bf29166",
  "ja": "トイレ、シャワー、グリル、焚き火場。"
 },
 {
  "id": "fb2c28445c",
  "ja": "ビーチサイド・山側・VIPの区画。予約可。"
 },
 {
  "id": "068c80360b",
  "ja": "高木の下、川沿いの草地の開けた場所。設備なし、未舗装路でアクセス。"
 },
 {
  "id": "b0066f126c",
  "ja": "ビーチサイド・川沿い・VIPの区画。マリンスポーツ可。"
 },
 {
  "id": "4a6be51762",
  "ja": "無料、夕日側。トイレとシャワーも無料。週末は日帰り客と共用。"
 },
 {
  "id": "3d80d2846e",
  "ja": "ビーチの区画。暗い夜空、夕日。"
 },
 {
  "id": "9069ef7333",
  "ja": "星空。トイレ、シャワー、炊事場。"
 },
 {
  "id": "38e31c15e8",
  "ja": "辺野喜川の河口。光害はごくわずか。"
 },
 {
  "id": "219d13c6e8",
  "ja": "林冠の下の区画。トイレ、シャワー。"
 },
 {
  "id": "5e41cf99c5",
  "ja": "海の眺め、朝日、暗い夜空。トイレ・シャワーなし。"
 },
 {
  "id": "cbaa97340c",
  "ja": "北東海岸、辺戸岬の南3 kmの日陰の区画。裾礁。"
 },
