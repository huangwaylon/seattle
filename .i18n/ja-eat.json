 {
  "id": "4d675e495a",
  "ja": "揚げたてのサーターアンダギーが&yen;150。スイーツ百名店2026、美ら海水族館の割引チケットもここで買えます。"
 },
 {
  "id": "0ccc148dd3",
  "ja": "創業50年の食堂。ミルクぜんざいは名護の定番です。"
 },
 {
  "id": "2686ad7e0c",
  "ja": "1948年から一品のみ、豆は薪で炊き上げます。美ら海水族館から10分。"
 },
 {
  "id": "932c8fef21",
  "ja": "沖縄のかき氷を象徴するマンゴーのアイスマウンテン。スイーツ百名店2026。"
 },
 {
  "id": "3854b15215",
  "ja": "座喜味城跡の入口。きめ細かい氷に読谷の紫芋。"
 },
 {
  "id": "c0ef85289c",
  "ja": "中部で唯一の本格モダンかき氷店。12席だけで、売り切れます。"
 },
 {
  "id": "6377406b53",
  "ja": "辺戸岬の観光案内所2階 &mdash; 東シナ海から太平洋までを一望。"
 },
 {
  "id": "382fdccb0d",
  "ja": "伊江島を望む丘の上の赤瓦の民家。本島でいちばん写真に撮られる絶景カフェ。"
 },
 {
  "id": "17e6fd5a44",
  "ja": "備瀬のフクギ並木の中、砂地のテラスから伊江島を望みます。08:00開店。"
 },
 {
  "id": "42b1342970",
  "ja": "斜面に吊られたハンモック席と、ほかでは飲めないぶくぶく茶。"
 },
 {
  "id": "37a0036e87",
  "ja": "岩場に建つ星野リゾートの断崖カフェ。屋外160席、日没から1時間で閉店。"
 },
 {
  "id": "fb7a715371",
  "ja": "アメリカンビレッジのルーフトップ。目線の高さに海が広がります。"
 },
 {
  "id": "234a928670",
  "ja": "150席、07:00&ndash;22:00 &mdash; シーウォール店が混み合うときの確実な代替。"
 },
 {
  "id": "004c546bc7",
  "ja": "紅イモタルトの元祖。本店には工場の見学窓もあります。"
 },
 {
  "id": "935d9c2dee",
  "ja": "1963年創業の本店、レトロなダイナー内装。紅イモと塩ちんすこうのスクープ。"
 },
 {
  "id": "b6ee639050",
  "ja": "外国人住宅街のフルーツタルト &mdash; 寄り道そのものが絵になります。"
 },
 {
  "id": "a486f471e4",
  "ja": "天然酵母のパンとスコーン。キャンプ旅のお土産に最適 &mdash; 冷蔵いらずです。"
 },
 {
  "id": "1b7fb4b451",
  "ja": "かき氷、カフェ、お土産スイーツ。いずれも3日間の日程で営業を確認済みです。数字は、そのドライブに\n      組み込みやすい日を示しています。三連休なので、有名店には行列ができます。"
 },
